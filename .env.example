# Öffentliche Basis-URL – erst setzen, wenn die Domain feststeht.
# Alle internen Links sind relativ; diese URL wird nur für Canonical, Sitemap und Open Graph verwendet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Geheimnis für den Cronjob, der geplante Artikel freischaltet (GET /api/revalidate mit "Authorization: Bearer <wert>").
CRON_SECRET=bitte-langen-zufallswert-eintragen

# Spendenlink für die Spendenbox "Panda GreenCore" (Zweck zusätzlich in lib/site.ts eintragen).
NEXT_PUBLIC_DONATION_URL=

# Werbeplätze erst aktivieren, wenn ein Werbenetzwerk eingebunden und im Datenschutz beschrieben ist.
NEXT_PUBLIC_ADS_ENABLED=false

# Redaktions-Cockpit (/redaktion) ist in Produktion standardmäßig aus. Nur hinter Zugriffsschutz aktivieren.
ENABLE_EDITOR_DASHBOARD=false

# 1 = strenge Freigabeprüfung (ungeprüfte Fakten blockieren den Build). Auf Vercel-Produktion automatisch aktiv.
CONTENT_STRICT=0
