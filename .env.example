# ---------- Datenbank & CMS (Payload) ----------
# Postgres-Verbindung, z. B. von Supabase oder Neon. NIE ins Repository committen.
DATABASE_URI=postgres://USER:PASSWORT@HOST:5432/DATENBANK
# Langer Zufallswert zum Signieren der Logins (z. B. `openssl rand -hex 32`).
PAYLOAD_SECRET=bitte-langen-zufallswert-eintragen

# Öffentliche Basis-URL – erst setzen, wenn die Domain feststeht.
# Alle internen Links sind relativ; diese URL wird nur für Canonical, Sitemap und Open Graph verwendet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console: Methode „HTML-Tag“ wählen und nur den Wert aus content="…" eintragen.
GOOGLE_SITE_VERIFICATION=
# Optional: Bing Webmaster Tools (Wert aus content="…" des msvalidate.01-Tags).
BING_SITE_VERIFICATION=

# Geheimnis für den Cronjob, der geplante Seiten freischaltet (GET /api/cron/revalidate mit "Authorization: Bearer <wert>").
CRON_SECRET=bitte-langen-zufallswert-eintragen

# Wartungsmodus: Jeder Administrator kann ihn im CMS verwalten.

# Werbeplätze erst aktivieren, wenn ein Werbenetzwerk eingebunden und im Datenschutz beschrieben ist.
NEXT_PUBLIC_ADS_ENABLED=false

# 1 = Veröffentlichen im CMS nur mit bestätigter Faktenprüfung (empfohlen für den Livegang).
CONTENT_STRICT=1

# Anonyme Besucherzählung (Startseite „Besuche“, „Gerade beliebt“, GreenTech-Pflanze).
# Standard: aus. Jede Zählung schreibt in die Datenbank und hält eine Neon-Datenbank wach.
# NEXT_PUBLIC_VISITOR_COUNTER=on

# Inhaltspakete laufen pro Code-Stand nur einmal. „always“ = bei jedem Start (nur zum Testen),
# „off“ = nie.
# CONTENT_PACKS=always
